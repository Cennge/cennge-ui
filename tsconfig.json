{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "cennge-ui": ["./src/index.ts"],
      "cennge-ui/utils": ["./src/utils/index.ts"],
      "cennge-ui/map": ["./src/map/index.ts"],
      "cennge-ui/charts": ["./src/charts/index.ts"]
    }
  },
  "include": ["src", "playground", "tests", "e2e", "*.config.ts"],
  // Built on its own, against the packed package: see scripts/check-next.mjs.
  "exclude": ["tests/next/app"]
}
