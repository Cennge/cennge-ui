{
  "name": "cennge-ui-site",
  "private": true,
  "type": "module",
  "scripts": {
    "props": "node scripts/props.mjs",
    "dev": "pnpm generate && next dev --port 3150",
    "build": "pnpm generate && next build && node scripts/flatten-segments.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "pnpm generate && tsc --noEmit",
