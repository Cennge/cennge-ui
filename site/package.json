    "@next/mdx": "16.4.2",
    "cennge-ui": "workspace:*",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "9.2.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
